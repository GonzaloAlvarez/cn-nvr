# cn-nvr — environment. The real .env is Kauket-managed (cerberus.cn_nvr_env,
# installed 0600 at /home/gonzalo/cn-nvr/.env); setup.sh never generates
# secrets. Comments on their own lines only: a trailing "# ..." becomes part
# of the value.

# ── Tailscale + Headscale ──────────────────────────────────────────────────
# Mint on the VPS: ssh hs.gn.al 'docker exec cloudnet-headscale-1 \
#   headscale preauthkeys create --user 2 --tags tag:svc --expiration 24h'
NVR_AUTHKEY=
HEADSCALE_DOMAIN=hs.gn.al
INFRA_VPS_TAILNET_IP=100.64.0.1
LAB_DOMAIN=lab.gn.al
TAILNET_DOMAIN=ts.gn.al

# ── Host + LAN names ───────────────────────────────────────────────────────
# Static LAN address of cerberus (pfSense static mapping). traefik-lan binds
# the HA-only entrypoints (5000/1883/8554) to it; setup.sh refuses to start
# if this address is not on the host.
CERBERUS_IP=10.0.0.230
NVR_LAN_HOST=nvr.cerberus.lan
GRAFANA_LAN_HOST=grafana.cerberus.lan
# homeiot.lan — the only client allowed on 5000/1883/8554
HA_IP=10.1.1.134

# ── step-ca + ops ──────────────────────────────────────────────────────────
PKI_IP=pki.lan
ADMIN_EMAIL=
TIMEZONE=America/New_York

# ── Cameras (substituted by Frigate into config.yml {FRIGATE_*} placeholders) ──
# AXIS P1465-LE-3 at 10.1.1.123 (camera "driveway"). Passwords are embedded
# in RTSP URLs: avoid @ : / ? # or percent-encode them.
FRIGATE_AXIS_USER=
FRIGATE_AXIS_PASSWORD=
# AXIS P5655-E PTZ at 10.1.1.151 (camera "ptz"); also used for ONVIF PTZ.
FRIGATE_AXISPTZ_USER=
FRIGATE_AXISPTZ_PASSWORD=
# ONVIF account on the PTZ (Axis: System -> ONVIF -> Accounts; separate from
# device accounts, Operator or Administrator role). Used for presets/PTZ.
FRIGATE_AXISPTZ_ONVIF_USER=
FRIGATE_AXISPTZ_ONVIF_PASSWORD=

# ── MQTT (Mosquitto users rendered into mosquitto/passwd by setup.sh) ──────
# user "frigate"
FRIGATE_MQTT_PASSWORD=
# user "homeassistant" (enter it in HA's MQTT integration)
HA_MQTT_PASSWORD=

# ── LPR ────────────────────────────────────────────────────────────────────
# Known plate rendered by setup.sh into lpr.known_plates.gonzalo_car (the
# tracked template keeps the ${NVR_PLATE_GONZALO} token; the rendered
# config/config.yml is gitignored). Letters/digits only, as printed on the plate.
NVR_PLATE_GONZALO=

# ── Grafana (grafana.cerberus.lan) ─────────────────────────────────────────
# Local admin = break-glass login. Re-applied on every restart.
GF_ADMIN_PASSWORD=
# Shared Authentik OAuth2 provider `grafana` (same pair as kaiser + VPS
# Grafana; cn-authentik/setup-grafana-oidc.sh owns the redirect URIs).
AUTHENTIK_GRAFANA_CLIENT_ID=
AUTHENTIK_GRAFANA_CLIENT_SECRET=

# ── SMTP — Watchtower + offen notifications (shared homelab values) ────────
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=

# ── Backup — shared S3 bucket + raidnas WebDAV ────────────────────────────
BACKUP_S3_BUCKET=cloudnet-lab-storage
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-2
# plain HTTP share; the app prefix goes in WEBDAV_PATH (compose), not here
BACKUP_WEBDAV_URL=http://raidnas.lan:5005
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
